<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_white">
    <item>
        <layer-list>
            <!-- Layer 1: Outer Chassis Bezel / Muted Ring -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#0B0C0E" />
                    <stroke android:width="1.5dp" android:color="#1F2025" />
                </shape>
            </item>
            <!-- Layer 2: Muted Concentric Ring -->
            <item
                android:top="4dp"
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp">
                <shape android:shape="oval">
                    <solid android:color="#00000000" />
                    <stroke android:width="1.5dp" android:color="#24252A" />
                </shape>
            </item>
            <!-- Layer 3: Tactile Physical Button Face in Stealth Standby -->
            <item
                android:top="9dp"
                android:bottom="9dp"
                android:left="9dp"
                android:right="9dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#18191E"
                        android:centerColor="#131416"
                        android:endColor="#0E0F11" />
                    <stroke android:width="1dp" android:color="#202229" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
