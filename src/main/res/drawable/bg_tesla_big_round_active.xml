<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_white">
    <item>
        <layer-list>
            <!-- Layer 1: Outer Chassis Bezel / Ambient Ring -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#0F1012" />
                    <stroke android:width="1.5dp" android:color="#282A32" />
                </shape>
            </item>
            <!-- Layer 2: Concentric Tesla Electric Blue Halo Accent -->
            <item
                android:top="4dp"
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp">
                <shape android:shape="oval">
                    <solid android:color="#00000000" />
                    <stroke android:width="2dp" android:color="@color/tesla_blue" />
                </shape>
            </item>
            <!-- Layer 3: Tactile Physical Button Face with Brushed Gunmetal Finish -->
            <item
                android:top="9dp"
                android:bottom="9dp"
                android:left="9dp"
                android:right="9dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#22252C"
                        android:centerColor="#18191E"
                        android:endColor="#111215" />
                    <stroke android:width="1dp" android:color="#323542" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
